# ─────────────────────────────────────────────────────────────────────────────
# Tenant App — Environment Variables
# Copy to .env.local and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# --- Neon (uncomment when using Neon, also uncomment directUrl in schema.prisma) ---
# DATABASE_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/bizconnect?sslmode=require&pgbouncer=true"
# DIRECT_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/bizconnect?sslmode=require"

# --- Supabase (uncomment when using Supabase) ---
# DATABASE_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# Auth.js / NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET="your-tenant-app-secret-here"
# Required for local LAN/device testing. On Vercel, Auth.js infers this safely.
AUTH_TRUST_HOST="true"
