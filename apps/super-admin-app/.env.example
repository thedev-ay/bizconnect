# ─────────────────────────────────────────────────────────────────────────────
# Super Admin App — Environment Variables
# Copy to .env.local and fill in your values
# Same DATABASE_URL as tenant-app — they share one database
# ─────────────────────────────────────────────────────────────────────────────

# --- Neon (uncomment when using Neon, also uncomment directUrl in schema.prisma) ---
# DATABASE_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/bizconnect?sslmode=require&pgbouncer=true"
# DIRECT_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/bizconnect?sslmode=require"

# --- Supabase (uncomment when using Supabase) ---
# DATABASE_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# NextAuth — DIFFERENT secret from tenant-app (intentional)
NEXTAUTH_SECRET="your-super-admin-secret-here-different-from-tenant"
NEXTAUTH_URL="http://localhost:3001"
