generator client {
  provider = "prisma-client-js"
  output   = "../src/generated"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// TENANT
// ─────────────────────────────────────────────────────────────────────────────

model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  plan      String   @default("starter")
  isActive  Boolean  @default(true)
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  tenantModules TenantModule[]

  @@map("tenants")
}

// ─────────────────────────────────────────────────────────────────────────────
// MODULE (seed-only, never mutated by end users)
// ─────────────────────────────────────────────────────────────────────────────

model Module {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  icon        String?
  isCore      Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  tenantModules TenantModule[]

  @@map("modules")
}

// ─────────────────────────────────────────────────────────────────────────────
// TENANT ↔ MODULE
// ─────────────────────────────────────────────────────────────────────────────

model TenantModule {
  id         String    @id @default(cuid())
  tenantId   String
  moduleId   String
  isEnabled  Boolean   @default(true)
  enabledAt  DateTime  @default(now())
  disabledAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([tenantId, moduleId])
  @@index([tenantId])
  @@map("tenant_modules")
}

// ─────────────────────────────────────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  tenantId      String?
  email         String    @unique
  name          String?
  passwordHash  String?
  role          String    @default("member")
  isSuperAdmin  Boolean   @default(false)
  isActive      Boolean   @default(true)
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant   Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accounts Account[]
  sessions Session[]

  @@index([tenantId])
  @@index([email])
  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// NEXTAUTH TABLES
// ─────────────────────────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// INVENTORY MODULE
// ─────────────────────────────────────────────────────────────────────────────

model InventoryCategory {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items InventoryItem[]

  @@index([tenantId])
  @@map("inventory_categories")
}

model InventoryItem {
  id          String             @id @default(cuid())
  tenantId    String
  categoryId  String?
  name        String
  sku         String?
  description String?
  quantity    Int                @default(0)
  reorderAt   Int                @default(0)
  unitCost    Decimal            @db.Decimal(10, 2)
  unitPrice   Decimal            @db.Decimal(10, 2)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  category  InventoryCategory?  @relation(fields: [categoryId], references: [id])
  saleItems SaleItem[]

  @@index([tenantId])
  @@index([tenantId, sku])
  @@map("inventory_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// POS MODULE
// ─────────────────────────────────────────────────────────────────────────────

model Sale {
  id            String    @id @default(cuid())
  tenantId      String
  referenceNo   String
  subtotal      Decimal   @db.Decimal(10, 2)
  discount      Decimal   @default(0) @db.Decimal(10, 2)
  total         Decimal   @db.Decimal(10, 2)
  amountPaid    Decimal   @db.Decimal(10, 2)
  change        Decimal   @default(0) @db.Decimal(10, 2)
  paymentMethod String    @default("cash")
  status        String    @default("completed")
  servedById    String?
  createdAt     DateTime  @default(now())

  items SaleItem[]

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@map("sales")
}

model SaleItem {
  id          String  @id @default(cuid())
  saleId      String
  itemId      String
  name        String
  quantity    Int
  unitPrice   Decimal @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)

  sale Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  item InventoryItem @relation(fields: [itemId], references: [id])

  @@map("sale_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// APPOINTMENTS MODULE
// ─────────────────────────────────────────────────────────────────────────────

model Appointment {
  id            String    @id @default(cuid())
  tenantId      String
  title         String
  customerName  String
  customerEmail String?
  customerPhone String?
  notes         String?
  startAt       DateTime
  endAt         DateTime
  status        String    @default("pending")
  employeeId    String?
  serviceId     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  employee      Employee? @relation(fields: [employeeId], references: [id])
  service       Service?  @relation(fields: [serviceId], references: [id])

  @@index([tenantId])
  @@index([tenantId, startAt])
  @@map("appointments")
}

// ─────────────────────────────────────────────────────────────────────────────
// BILLING MODULE
// ─────────────────────────────────────────────────────────────────────────────

model Invoice {
  id          String    @id @default(cuid())
  tenantId    String
  invoiceNo   String
  customerName String
  customerEmail String?
  dueDate     DateTime
  subtotal    Decimal   @db.Decimal(10, 2)
  tax         Decimal   @default(0) @db.Decimal(10, 2)
  total       Decimal   @db.Decimal(10, 2)
  status      String    @default("draft")
  notes       String?
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  items InvoiceItem[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Int
  unitPrice   Decimal @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// CRM MODULE
// ─────────────────────────────────────────────────────────────────────────────

model Customer {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  email     String?
  phone     String?
  address   String?
  notes     String?
  tags      String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("customers")
}

// ─────────────────────────────────────────────────────────────────────────────
// JOB ORDERS MODULE
// ─────────────────────────────────────────────────────────────────────────────

model JobOrder {
  id           String   @id @default(cuid())
  tenantId     String
  jobNo        String
  customerName String
  description  String
  status       String   @default("pending")
  priority     String   @default("normal")
  assignedTo   String?
  dueDate      DateTime?
  completedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("job_orders")
}

// ─────────────────────────────────────────────────────────────────────────────
// HR MODULE
// ─────────────────────────────────────────────────────────────────────────────

model Employee {
  id             String    @id @default(cuid())
  tenantId       String
  userId         String?
  employeeNo     String?
  name           String
  email          String?
  phone          String?
  position       String?
  department     String?
  hireDate       DateTime?
  salary         Decimal?  @db.Decimal(10, 2)
  commissionRate Decimal?  @db.Decimal(5, 2)
  accessLevel    String    @default("staff")
  photoUrl       String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  shifts         Shift[]
  services       StaffService[]
  workingHours   WorkingHours[]
  appointments   Appointment[]
  attendance     Attendance[]
  leaveRequests  LeaveRequest[]
  payrollRecords PayrollRecord[]

  @@index([tenantId])
  @@map("employees")
}

// ─────────────────────────────────────────────────────────────────────────────
// STAFF MANAGEMENT MODULE
// ─────────────────────────────────────────────────────────────────────────────

model Service {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  duration    Int      // minutes
  price       Decimal  @db.Decimal(10, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  staff        StaffService[]
  appointments Appointment[]

  @@index([tenantId])
  @@map("services")
}

model StaffService {
  id         String   @id @default(cuid())
  employeeId String
  serviceId  String

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([employeeId, serviceId])
  @@map("staff_services")
}

model WorkingHours {
  id         String @id @default(cuid())
  employeeId String
  dayOfWeek  Int    // 0=Sun, 1=Mon ... 6=Sat
  startTime  String // "09:00"
  endTime    String // "17:00"

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, dayOfWeek])
  @@map("working_hours")
}

model Shift {
  id         String   @id @default(cuid())
  tenantId   String
  employeeId String
  title      String?
  startAt    DateTime
  endAt      DateTime
  notes      String?
  createdAt  DateTime @default(now())

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, startAt])
  @@map("shifts")
}

// ─────────────────────────────────────────────────────────────────────────────
// HR / PAYROLL MODULE
// ─────────────────────────────────────────────────────────────────────────────

model Attendance {
  id         String    @id @default(cuid())
  tenantId   String
  employeeId String
  date       DateTime  @db.Date
  clockIn    DateTime?
  clockOut   DateTime?
  notes      String?
  createdAt  DateTime  @default(now())

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([tenantId])
  @@map("attendance")
}

model LeaveRequest {
  id         String   @id @default(cuid())
  tenantId   String
  employeeId String
  type       String   // sick, vacation, personal, unpaid
  startDate  DateTime @db.Date
  endDate    DateTime @db.Date
  reason     String?
  status     String   @default("pending") // pending, approved, rejected
  createdAt  DateTime @default(now())

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("leave_requests")
}

model PayrollRecord {
  id          String   @id @default(cuid())
  tenantId    String
  employeeId  String
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date
  baseSalary  Decimal  @db.Decimal(10, 2)
  commission  Decimal  @default(0) @db.Decimal(10, 2)
  deductions  Decimal  @default(0) @db.Decimal(10, 2)
  netPay      Decimal  @db.Decimal(10, 2)
  status      String   @default("draft") // draft, processed, paid
  notes       String?
  createdAt   DateTime @default(now())

  employee    Employee @relation(fields: [employeeId], references: [id])

  @@index([tenantId])
  @@map("payroll_records")
}
