generator client {
  provider = "prisma-client-js"
  output   = "../src/generated"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// TENANT
// ─────────────────────────────────────────────────────────────────────────────

model Tenant {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  country        String   @default("ph")
  plan           String   @default("starter")
  isActive       Boolean  @default(true) @map("is_active")
  logoUrl        String?  @map("logo_url")
  address        String?
  phone          String?
  email          String?
  website        String?
  industry       String?
  companySize    String?  @map("company_size")
  tags           String[] @default([])
  currencySymbol String   @default("₱") @map("currency_symbol")
  currencyLocale String   @default("en-PH") @map("currency_locale")
  defaultTaxRate Decimal  @default(0) @db.Decimal(5, 2) @map("default_tax_rate")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  users           User[]
  tenantModules   TenantModule[]
  businessHours   BusinessHours[]
  loyaltySetting  LoyaltySetting?
  loyaltyCards    LoyaltyCard[]
  workflowStages  WorkflowStage[]
  branches        Branch[]
  assets          Asset[]

  @@map("tenants")
}

// ─────────────────────────────────────────────────────────────────────────────
// BRANCH
// ─────────────────────────────────────────────────────────────────────────────

model Branch {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  slug      String
  name      String
  address   String?
  phone     String?
  email     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant      Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employees   Employee[]                 @relation("homeBranch")
  assignments EmployeeBranchAssignment[]
  assets      Asset[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("branches")
}

model EmployeeBranchAssignment {
  id         String    @id @default(cuid())
  employeeId String    @map("employee_id")
  branchId   String    @map("branch_id")
  startDate  DateTime  @map("start_date") @db.Date
  endDate    DateTime? @map("end_date") @db.Date
  notes      String?
  createdAt  DateTime  @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([branchId])
  @@map("employee_branch_assignments")
}

model BusinessHours {
  id        String  @id @default(cuid())
  tenantId  String  @map("tenant_id")
  dayOfWeek Int     @map("day_of_week")
  isOpen    Boolean @default(true) @map("is_open")
  openTime  String  @default("09:00") @map("open_time")
  closeTime String  @default("18:00") @map("close_time")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, dayOfWeek])
  @@index([tenantId])
  @@map("business_hours")
}

// ─────────────────────────────────────────────────────────────────────────────
// MODULE
// ─────────────────────────────────────────────────────────────────────────────

model Module {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  icon        String?
  isCore      Boolean  @default(false) @map("is_core")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  tenantModules TenantModule[]

  @@map("modules")
}

// ─────────────────────────────────────────────────────────────────────────────
// TENANT ↔ MODULE
// ─────────────────────────────────────────────────────────────────────────────

model TenantModule {
  id         String    @id @default(cuid())
  tenantId   String    @map("tenant_id")
  moduleId   String    @map("module_id")
  isEnabled  Boolean   @default(true) @map("is_enabled")
  enabledAt  DateTime  @default(now()) @map("enabled_at")
  disabledAt DateTime? @map("disabled_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([tenantId, moduleId])
  @@index([tenantId])
  @@map("tenant_modules")
}

// ─────────────────────────────────────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  tenantId      String?   @map("tenant_id")
  email         String    @unique
  name          String?
  passwordHash  String?   @map("password_hash")
  role          String    @default("member")
  permissions   Json      @default("{}")
  isSuperAdmin  Boolean   @default(false) @map("is_super_admin")
  isActive      Boolean   @default(true) @map("is_active")
  emailVerified DateTime? @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tenant   Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accounts Account[]
  sessions Session[]

  @@index([tenantId])
  @@index([email])
  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// NEXTAUTH TABLES
// ─────────────────────────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PasswordResetToken {
  identifier String    // email address
  token      String    @unique
  expires    DateTime

  @@unique([identifier, token])
  @@index([expires])
  @@map("password_reset_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// INVENTORY MODULE
// ─────────────────────────────────────────────────────────────────────────────

model InventoryCategory {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items InventoryItem[]

  @@index([tenantId])
  @@map("inventory_categories")
}

model InventoryItem {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  branchId    String?   @map("branch_id")
  categoryId  String?   @map("category_id")
  name        String
  sku         String?
  description String?
  quantity    Int       @default(0)
  reorderAt   Int       @default(0) @map("reorder_at")
  unitCost    Decimal   @db.Decimal(10, 2) @map("unit_cost")
  unitPrice   Decimal   @db.Decimal(10, 2) @map("unit_price")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  category   InventoryCategory? @relation(fields: [categoryId], references: [id])
  saleItems  SaleItem[]
  promotions PromotionItem[]
  adjustments InventoryAdjustment[]

  @@index([tenantId])
  @@index([tenantId, branchId])
  @@index([tenantId, sku])
  @@map("inventory_items")
}

model InventoryAdjustment {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  branchId        String?  @map("branch_id")
  itemId          String   @map("item_id")
  quantityChange  Int      @map("quantity_change") // positive or negative
  reason          String?  // "manual", "sale_void", "damage", "recount", etc.
  notes           String?
  adjustedById    String?  @map("adjusted_by_id")
  createdAt       DateTime @default(now()) @map("created_at")

  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, branchId])
  @@index([itemId])
  @@index([createdAt])
  @@map("inventory_adjustments")
}

// ─────────────────────────────────────────────────────────────────────────────
// POS MODULE
// ─────────────────────────────────────────────────────────────────────────────

model Sale {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  branchId      String?  @map("branch_id")
  referenceNo   String   @map("reference_no")
  source        String   @default("pos") // "pos" | "job-order" | "appointment"
  subtotal      Decimal  @db.Decimal(10, 2)
  discount      Decimal  @default(0) @db.Decimal(10, 2)
  total         Decimal  @db.Decimal(10, 2)
  amountPaid    Decimal  @db.Decimal(10, 2) @map("amount_paid")
  change        Decimal  @default(0) @db.Decimal(10, 2)
  paymentMethod String   @default("cash") @map("payment_method")
  status        String   @default("completed")
  servedById    String?  @map("served_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  items   SaleItem[]
  returns SaleReturn[]

  @@index([tenantId])
  @@index([tenantId, branchId])
  @@index([tenantId, createdAt])
  @@map("sales")
}

model SaleItem {
  id            String   @id @default(cuid())
  saleId        String   @map("sale_id")
  itemId        String?  @map("item_id")        // null for service line items
  itemType      String   @default("product") @map("item_type")
  name          String
  quantity      Int
  weight        Decimal? @db.Decimal(10, 3) @map("weight") // kg for per_kilo services
  unitPrice     Decimal  @db.Decimal(10, 2) @map("unit_price")
  originalPrice Decimal  @default(0) @db.Decimal(10, 2) @map("original_price")
  promoDiscount Decimal  @default(0) @db.Decimal(10, 2) @map("promo_discount")
  total         Decimal  @db.Decimal(10, 2)

  sale Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  item InventoryItem? @relation(fields: [itemId], references: [id])

  @@map("sale_items")
}

model SaleReturn {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  branchId        String?  @map("branch_id")
  saleId          String   @map("sale_id")
  referenceNo     String   @map("reference_no") // e.g., "RMA-20260403-1234"
  reason          String   // "defective", "wrong_item", "changed_mind", "damaged", "other"
  notes           String?
  status          String   @default("pending") // "pending" | "approved" | "rejected" | "refunded"
  refundAmount    Decimal? @db.Decimal(10, 2) @map("refund_amount")
  refundMethod    String?  @map("refund_method") // "cash" | "original_payment" | "credit_note"
  approvedById    String?  @map("approved_by_id")
  approvedAt      DateTime? @map("approved_at")
  refundedAt      DateTime? @map("refunded_at")
  createdAt       DateTime @default(now()) @map("created_at")

  sale  Sale              @relation(fields: [saleId], references: [id], onDelete: Cascade)
  items SaleReturnItem[]

  @@index([tenantId])
  @@index([saleId])
  @@index([status])
  @@map("sale_returns")
}

model SaleReturnItem {
  id           String  @id @default(cuid())
  returnId     String  @map("return_id")
  saleItemId   String  @map("sale_item_id")
  quantity     Int
  restockAmount Decimal? @db.Decimal(10, 2) @map("restock_amount") // optional partial refund

  return SaleReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@map("sale_return_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// PROMOTIONS MODULE
// ─────────────────────────────────────────────────────────────────────────────

model Promotion {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  name        String
  description String?
  type        String    // "percent_off" | "flat_off" | "fixed_price" | "buy_x_get_y" | "day_time"
  value       Decimal   @default(0) @db.Decimal(10, 2)  // percent / flat amount / fixed price
  buyQty      Int?      @map("buy_qty")   // for buy_x_get_y
  getQty      Int?      @map("get_qty")   // for buy_x_get_y
  daysOfWeek  Json?     @map("days_of_week")  // [0,1,2...6] for day_time type
  startTime   String?   @map("start_time")   // "HH:MM" for day_time type
  endTime     String?   @map("end_time")     // "HH:MM" for day_time type
  startsAt    DateTime? @map("starts_at")
  endsAt      DateTime? @map("ends_at")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  items PromotionItem[]

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("promotions")
}

model PromotionItem {
  id          String @id @default(cuid())
  promotionId String @map("promotion_id")
  itemId      String @map("item_id")

  promotion   Promotion     @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  item        InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([promotionId, itemId])
  @@map("promotion_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// APPOINTMENTS MODULE
// ─────────────────────────────────────────────────────────────────────────────

model Appointment {
  id            String    @id @default(cuid())
  tenantId      String    @map("tenant_id")
  branchId      String?   @map("branch_id")
  title         String
  customerName  String    @map("customer_name")
  customerEmail String?   @map("customer_email")
  customerPhone String?   @map("customer_phone")
  notes         String?
  startAt       DateTime  @map("start_at")
  endAt         DateTime  @map("end_at")
  status        String    @default("pending")
  employeeId    String?   @map("employee_id")
  staffName     String?   @map("staff_name")
  serviceId     String?   @map("service_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  employee Employee? @relation(fields: [employeeId], references: [id])
  service  Service?  @relation(fields: [serviceId], references: [id])

  @@index([tenantId])
  @@index([tenantId, branchId])
  @@index([tenantId, startAt])
  @@map("appointments")
}

// ─────────────────────────────────────────────────────────────────────────────
// BILLING MODULE
// ─────────────────────────────────────────────────────────────────────────────

model Invoice {
  id            String    @id @default(cuid())
  tenantId      String    @map("tenant_id")
  branchId      String?   @map("branch_id")
  customerId    String?   @map("customer_id")
  jobOrderId    String?   @unique @map("job_order_id")
  invoiceNo     String    @map("invoice_no")
  customerName  String    @map("customer_name")
  customerEmail String?   @map("customer_email")
  dueDate       DateTime  @map("due_date")
  subtotal      Decimal   @db.Decimal(10, 2)
  tax           Decimal   @default(0) @db.Decimal(10, 2)
  total         Decimal   @db.Decimal(10, 2)
  status        String    @default("draft")
  notes         String?
  paidAt        DateTime? @map("paid_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  jobOrder JobOrder? @relation(fields: [jobOrderId], references: [id], onDelete: SetNull)
  items    InvoiceItem[]

  @@index([tenantId])
  @@index([tenantId, branchId])
  @@index([tenantId, status])
  @@index([customerId])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String  @map("invoice_id")
  description String
  quantity    Int
  unitPrice   Decimal @db.Decimal(10, 2) @map("unit_price")
  total       Decimal @db.Decimal(10, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// CRM MODULE
// ─────────────────────────────────────────────────────────────────────────────

model Customer {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  branchId  String?  @map("branch_id")
  name      String
  email     String?
  phone     String?
  address   String?
  notes     String?
  tags      String[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  invoices  Invoice[]
  jobOrders JobOrder[]
  assets    Asset[]

  @@index([tenantId])
  @@index([tenantId, branchId])
  @@map("customers")
}

model Asset {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  branchId   String?  @map("branch_id")
  customerId String   @map("customer_id")
  name       String
  assetType  String   @map("asset_type")
  brand      String?
  model      String?
  identifier String?
  serialNo   String?  @map("serial_no")
  status     String   @default("active")
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  branch    Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customer  Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  jobOrders JobOrder[]

  @@index([tenantId])
  @@index([tenantId, branchId])
  @@index([tenantId, customerId])
  @@index([tenantId, status])
  @@map("assets")
}

// ─────────────────────────────────────────────────────────────────────────────
// JOB ORDERS MODULE
// ─────────────────────────────────────────────────────────────────────────────

model JobOrder {
  id           String    @id @default(cuid())
  tenantId     String    @map("tenant_id")
  branchId     String?   @map("branch_id")
  customerId   String?   @map("customer_id")
  assetId      String?   @map("asset_id")
  jobNo        String    @map("job_no")
  customerName String    @map("customer_name")
  contactNo    String?   @map("contact_no")
  notes        String?
  status       String    @default("received")
  priority     String    @default("normal")
  dueDate      DateTime? @map("due_date")
  completedAt  DateTime? @map("completed_at")
  claimedAt    DateTime? @map("claimed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  asset       Asset?    @relation(fields: [assetId], references: [id], onDelete: SetNull)
  invoice     Invoice?
  items       JobOrderItem[]
  assignments JobOrderAssignment[]

  @@index([tenantId])
  @@index([tenantId, branchId])
  @@index([tenantId, status])
  @@index([customerId])
  @@index([assetId])
  @@map("job_orders")
}

model JobOrderItem {
  id         String   @id @default(cuid())
  jobOrderId String   @map("job_order_id")
  name       String
  quantity   Int      @default(1)
  weight     Decimal? @db.Decimal(10, 3)
  unitPrice  Decimal  @db.Decimal(10, 2) @map("unit_price")
  total      Decimal  @db.Decimal(10, 2)

  jobOrder JobOrder @relation(fields: [jobOrderId], references: [id], onDelete: Cascade)

  @@map("job_order_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// JOB ORDER WORKFLOW
// ─────────────────────────────────────────────────────────────────────────────

model JobOrderAssignment {
  id           String @id @default(cuid())
  jobOrderId   String @map("job_order_id")
  employeeId   String @map("employee_id")
  employeeName String @map("employee_name")

  jobOrder JobOrder @relation(fields: [jobOrderId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([jobOrderId, employeeId])
  @@index([jobOrderId])
  @@map("job_order_assignments")
}

model WorkflowStage {
  id        String  @id @default(cuid())
  tenantId  String  @map("tenant_id")
  branchId  String? @map("branch_id")
  name      String
  slug      String
  sortOrder Int     @map("sort_order")
  type      String  @default("active") // active | completed | cancelled

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, branchId])
  @@map("workflow_stages")
}

// ─────────────────────────────────────────────────────────────────────────────
// LOYALTY MODULE
// ─────────────────────────────────────────────────────────────────────────────

model LoyaltySetting {
  id                String  @id @default(cuid())
  tenantId          String  @unique @map("tenant_id")
  stampsPerReward   Int     @default(10) @map("stamps_per_reward")
  rewardDescription String  @default("1 Free Wash") @map("reward_description")
  isActive          Boolean @default(true) @map("is_active")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("loyalty_settings")
}

model LoyaltyCard {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  customerName  String   @map("customer_name")
  phone         String?
  currentStamps Int      @default(0) @map("current_stamps")
  totalStamps   Int      @default(0) @map("total_stamps")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stamps      LoyaltyStamp[]
  redemptions LoyaltyRedemption[]

  @@index([tenantId])
  @@index([tenantId, phone])
  @@map("loyalty_cards")
}

model LoyaltyStamp {
  id        String   @id @default(cuid())
  cardId    String   @map("card_id")
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  card LoyaltyCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@map("loyalty_stamps")
}

model LoyaltyRedemption {
  id         String   @id @default(cuid())
  cardId     String   @map("card_id")
  stampsUsed Int      @map("stamps_used")
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")

  card LoyaltyCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@map("loyalty_redemptions")
}

// ─────────────────────────────────────────────────────────────────────────────
// HR MODULE
// ─────────────────────────────────────────────────────────────────────────────

model Employee {
  id             String    @id @default(cuid())
  tenantId       String    @map("tenant_id")
  homeBranchId   String?   @map("home_branch_id")
  userId         String?   @map("user_id")
  employeeNo     String?   @map("employee_no")
  name           String
  email          String?
  phone          String?
  position       String?
  department     String?
  hireDate       DateTime? @map("hire_date")
  salary         Decimal?  @db.Decimal(10, 2)
  commissionRate Decimal?  @db.Decimal(5, 2) @map("commission_rate")
  accessLevel    String    @default("staff") @map("access_level")
  photoUrl       String?   @map("photo_url")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  homeBranch          Branch?                    @relation("homeBranch", fields: [homeBranchId], references: [id])
  branchAssignments   EmployeeBranchAssignment[]
  shifts              Shift[]
  services            StaffService[]
  workingHours        WorkingHours[]
  appointments        Appointment[]
  attendance          Attendance[]
  leaveRequests       LeaveRequest[]
  payrollRecords      PayrollRecord[]
  jobOrderAssignments JobOrderAssignment[]

  @@index([tenantId])
  @@index([tenantId, homeBranchId])
  @@map("employees")
}

// ─────────────────────────────────────────────────────────────────────────────
// STAFF MANAGEMENT MODULE
// ─────────────────────────────────────────────────────────────────────────────

model Service {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  name        String
  description String?
  duration    Int?
  pricingType String   @default("flat") @map("pricing_type") // per_piece | per_kilo | flat
  price       Decimal  @db.Decimal(10, 2)
  category    String?
  isActive    Boolean  @default(true) @map("is_active")
  availableForAppointments Boolean @default(true) @map("available_for_appointments")
  availableForJobOrders    Boolean @default(true) @map("available_for_job_orders")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  staff        StaffService[]
  appointments Appointment[]

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("services")
}

model StaffService {
  id         String @id @default(cuid())
  employeeId String @map("employee_id")
  serviceId  String @map("service_id")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([employeeId, serviceId])
  @@map("staff_services")
}

model WorkingHours {
  id         String @id @default(cuid())
  employeeId String @map("employee_id")
  dayOfWeek  Int    @map("day_of_week")
  startTime  String @map("start_time")
  endTime    String @map("end_time")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, dayOfWeek])
  @@map("working_hours")
}

model Shift {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  branchId   String?  @map("branch_id")
  employeeId String   @map("employee_id")
  title      String?
  startAt    DateTime @map("start_at")
  endAt      DateTime @map("end_at")
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, startAt])
  @@map("shifts")
}

// ─────────────────────────────────────────────────────────────────────────────
// HR / PAYROLL MODULE
// ─────────────────────────────────────────────────────────────────────────────

model Attendance {
  id         String    @id @default(cuid())
  tenantId   String    @map("tenant_id")
  branchId   String?   @map("branch_id")
  employeeId String    @map("employee_id")
  date       DateTime  @db.Date
  clockIn    DateTime? @map("clock_in")
  clockOut   DateTime? @map("clock_out")
  notes      String?
  createdAt  DateTime  @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([tenantId])
  @@map("attendance")
}

model LeaveRequest {
  id         String    @id @default(cuid())
  tenantId   String    @map("tenant_id")
  branchId   String?   @map("branch_id")
  employeeId String    @map("employee_id")
  type       String
  startDate  DateTime  @db.Date @map("start_date")
  endDate    DateTime? @db.Date @map("end_date")
  reason     String?
  status     String    @default("pending")
  createdAt  DateTime  @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("leave_requests")
}

model PayrollRecord {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  branchId    String?  @map("branch_id")
  employeeId  String   @map("employee_id")
  periodStart DateTime @db.Date @map("period_start")
  periodEnd   DateTime @db.Date @map("period_end")
  baseSalary  Decimal  @db.Decimal(10, 2) @map("base_salary")
  commission  Decimal  @default(0) @db.Decimal(10, 2)
  deductions  Decimal  @default(0) @db.Decimal(10, 2)
  netPay      Decimal  @db.Decimal(10, 2) @map("net_pay")
  status      String   @default("draft")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([tenantId])
  @@map("payroll_records")
}
